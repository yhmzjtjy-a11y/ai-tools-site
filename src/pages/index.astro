---
const tools = [
  {
    name: "AI Chat",
    desc: "智能对话助手，支持学习/写作/代码",
    url: "https://chat.openai.com"
  },
  {
    name: "AI Image Generator",
    desc: "文本生成图片工具",
    url: "https://www.midjourney.com"
  },
  {
    name: "AI Search",
    desc: "下一代AI搜索引擎",
    url: "https://www.perplexity.ai"
  }
];
---

<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <title>AI Tools Hub</title>
    <meta name="description" content="精选AI工具导航站" />
    <style>
      body {
        font-family: system-ui;
        margin: 0;
        background: #0b0f19;
        color: white;
      }
      header {
        padding: 60px 20px;
        text-align: center;
      }
      h1 {
        font-size: 40px;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 16px;
        padding: 20px;
      }
      .card {
        background: #151c2c;
        padding: 16px;
        border-radius: 12px;
        transition: 0.2s;
      }
      .card:hover {
        transform: translateY(-4px);
      }
      a {
        color: #4da3ff;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
    <header>
      <h1>AI Tools Hub</h1>
      <p>一站式AI工具导航</p>
    </header>

    <div class="grid">
      {tools.map(tool => (
        <div class="card">
          <h3>{tool.name}</h3>
          <p>{tool.desc}</p>
          <a href={tool.url} target="_blank">打开 →</a>
        </div>
      ))}
    </div>
  </body>
</html>

---
const { name, desc, url, tag } = Astro.props;
---

<div style="
  background:#151c2c; 
  padding:20px; 
  border-radius:15px; 
  box-shadow:0 8px 20px rgba(0,0,0,0.5); 
  transition: transform 0.2s, box-shadow 0.2s;
">
  <h3 style="color:#4da3ff;">{name}</h3>
  <p style="margin:10px 0; color:#ddd;">{desc}</p>
  <span style="font-size:12px; color:#888;">{tag}</span>
  <br/>
  <a href={url} target="_blank" style="
    display:inline-block; 
    margin-top:10px; 
    padding:8px 16px; 
    border-radius:25px; 
    background:linear-gradient(90deg,#4da3ff,#1a8cff); 
    color:white; 
    text-decoration:none;
    transition: background 0.3s;
  ">访问 →</a>
</div>

<style>
  div:hover {
    transform: translateY(-5px);
    box-shadow:0 12px 25px rgba(0,0,0,0.7);
  }
</style>
